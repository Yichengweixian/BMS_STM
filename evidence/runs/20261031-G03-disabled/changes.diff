+/**
+  * @brief  串口收到一帧（IDLE 断帧）后的命令处理
+  * @param  huart: UART 句柄
+  * @param  Size : 本帧有效字节数
+  * @note   运行在中断上下文，不能阻塞、不能长耗时；
+  *         处理完必须调 uart_rx_restart()，否则 HAL 已关闭接收，只能收到这一帧。
+  *         数据用 uart_rx_data() 取（长度 Size），只在本次回调内有效。
+  */
+void HAL_UARTEx_RxEventCallback(UART_HandleTypeDef *huart, uint16_t Size)
+{
+  if (huart->Instance != USART1)
+  {
+    return;
+  }
+
+  /* Measurement stream owns TX. Never interleave ISR echo into CSV frames. */
+  G02_LinkRx(uart_rx_data(), Size);
+
+  uart_rx_restart();
+}
