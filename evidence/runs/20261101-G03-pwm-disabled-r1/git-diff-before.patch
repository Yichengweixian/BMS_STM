-    r = (a[2] < (VREF2_VOLT - 0.001f)) ? a[2] * R_UP / (VREF2_VOLT - a[2]) : 0.0f;
-    *t2 = (r / PT_R0 - 1.0f) / PT_ALPHA;
-    r = (b[0] < (VREF2_VOLT - 0.001f)) ? b[0] * R_UP / (VREF2_VOLT - b[0]) : 0.0f;
-    *t3 = (r / PT_R0 - 1.0f) / PT_ALPHA;
-}
