+	G02_PortInit();
+	Measurement_Init();
+
+  /* USER CODE END 2 */
+
+  /* Infinite loop */
+  /* USER CODE BEGIN WHILE */
+  while (1)
+  {
+    /* USER CODE END WHILE */
+
+    /* USER CODE BEGIN 3 */
+    G02_Task();
+    G02_LinkTask();
+    if (G02_MeasurementAllowed()) Measurement_Task();
+    HAL_Delay(1);
+  }
+  /* USER CODE END 3 */
+}
